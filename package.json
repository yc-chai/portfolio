{
  "scripts": {
    "lint": "eslint src/js && prettier --check src/",
    "format": "prettier --write src/",
    "optimize-images": "npx imagemin public/img/* --out-dir=public/img/optimized"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.1.0",
    "imagemin-cli": "^3.0.0",
    "prettier": "^3.5.3",
    "stylelint": "^16.19.1"
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "rules": {
      "no-descending-specificity": null
    }
  }
}
